# Autonomous AI Agent Beacon Configuration

# Secret key for HMAC challenge generation and validation (Generate a random 64-character hex string)
BEACON_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars

# Admin bearer token for accessing /admin dashboard
ADMIN_SECRET_TOKEN=change-this-to-a-secure-admin-token-min-16-chars

# Maximum allowed challenge turnaround time in seconds (inverted CAPTCHA gate)
CHALLENGE_TIMEOUT_SECONDS=3.0

# Rate limits (requests per minute per IP for challenge generation and dispatch)
RATE_LIMIT_CHALLENGE=12/minute
RATE_LIMIT_DISPATCH=6/minute

# Maximum allowed request body size in bytes (16 KB)
MAX_BODY_SIZE_BYTES=16384

# Maximum stored dispatches before FIFO auto-pruning
MAX_STORED_DISPATCHES=5000

# Optional Discord Webhook URL for real-time dispatch alerts
# Leave empty to disable Discord notifications
DISCORD_WEBHOOK_URL=

# Database file path
DATABASE_URL=sqlite:///./beacon.db
